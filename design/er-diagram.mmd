erDiagram
    USER ||..|| CUSTOMER : "has"
    USER ||..|| TRANSACTION : "makes"
    ACCOUNT_TYPE ||..|| ACCOUNT : "has"
    CUSTOMER ||..|| ACCOUNT : "owns"
    ACCOUNT ||..|| TRANSACTION : "has"
    TRANSACTION ||..|| INTEREST_RUN : "generated by"
    USER ||..|| INTEREST_RUN : "runs"
    USER ||..|| AUDIT_LOG : "creates"

    USER {
        int user_id PK
        varchar username
        varchar role
        varchar status
        int failed_attempts
        varchar password_hash
        timestamp created_at
        timestamp updated_at
    }

    CUSTOMER {
        int customer_id PK
        int user_id FK
        varchar full_name
        varchar email
        varchar phone
        varchar address
        timestamp date_of_birth
        timestamp created_at
        timestamp updated_at
    }

    ACCOUNT_TYPE {
        int type_id PK
        varchar type_name
        int min_balance
        int interest_rate
        int daily_withdrawal_limit
        timestamp created_at
    }

    ACCOUNT {
        int account_id PK
        varchar account_number
        int customer_id FK
        int type_id FK
        varchar status
        int balance
        timestamp opened_at
        timestamp created_at
        timestamp updated_at
    }

    TRANSACTION {
        int transaction_id PK
        int account_id FK
        int operator_id FK
        varchar type
        int amount
        int resulting_balance
        timestamp created_at
        varchar transfer_ref
        int interest_run_id FK
    }

    AUDIT_LOG {
        int log_id PK
        int user_id FK
        varchar action
        varchar entity
        int entity_id
        varchar details
        timestamp timestamp
    }

    INTEREST_RUN {
        int run_id PK
        varchar period
        int run_by FK
        timestamp run_at
        int accounts_credited
        int total_interest
    }